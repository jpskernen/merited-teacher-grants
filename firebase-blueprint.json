{
  "entities": {
    "ProgramSettings": {
      "title": "ProgramSettings",
      "description": "Administrative configuration for the NEF grant program cycle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "program": { "type": "string" },
        "season": { "type": "string" },
        "schoolYear": { "type": "string" },
        "callForGrantsDate": { "type": "string" },
        "applicationsDueDate": { "type": "string" },
        "reviewClosesDate": { "type": "string" },
        "awardsAnnouncedDate": { "type": "string" },
        "awardsPresentedDate": { "type": "string" },
        "category1Cap": { "type": "number" },
        "category2Cap": { "type": "number" },
        "availableFunds": { "type": "number" },
        "notificationThreshold": { "type": "number" },
        "adminEmailRecipient": { "type": "string" },
        "applicationIntakeMode": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "category1Cap", "category2Cap"]
    },
    "Rubric": {
      "title": "Rubric",
      "description": "Scoring rubric criteria, weights, and descriptors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "criteria": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "criteria"]
    },
    "Application": {
      "title": "Application",
      "description": "Blind grant proposal document viewable by reviewers and admins (no applicant PII)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "grantCode": { "type": "string" },
        "sequenceNumber": { "type": "number" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "gradeLevels": { "type": "array" },
        "subjectArea": { "type": "string" },
        "objectives": { "type": "string" },
        "areaOfFocus": { "type": "string" },
        "areaOfFocusOther": { "type": "string" },
        "abstract": { "type": "string" },
        "amountRequested": { "type": "number" },
        "studentsImpacted": { "type": "number" },
        "evaluationStrategy": { "type": "string" },
        "partners": { "type": "string" },
        "sustainability": { "type": "string" },
        "plainTextBudget": { "type": "string" },
        "involvesTech": { "type": "boolean" },
        "involvesFacilities": { "type": "boolean" },
        "status": { "type": "string" },
        "statusReason": { "type": "string" },
        "committeeFeedback": { "type": "string" },
        "awardedAmount": { "type": "number" },
        "adminEligibility": { "type": "object" },
        "assignedReviewerIds": { "type": "array" },
        "teacherUid": { "type": "string" },
        "teacherEmail": { "type": "string" },
        "openedForReviewAt": { "type": "string" },
        "decisionEmailSentAt": { "type": "string" },
        "adminNotifiedAt": { "type": "string" },
        "rowTimestamp": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "grantCode", "title", "status"]
    },
    "ApplicantIdentity": {
      "title": "ApplicantIdentity",
      "description": "Sensitive applicant personal identity details accessible only to Admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicationId": { "type": "string" },
        "grantCode": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "applicantNames": { "type": "array" },
        "campus": { "type": "string" },
        "principalEmail": { "type": "string" },
        "electronicSignature": { "type": "string" },
        "signedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "applicationId", "grantCode", "applicantEmail"]
    },
    "GrantCounter": {
      "title": "GrantCounter",
      "description": "Atomic Firestore counter for grant sequence codes (IGF2601, IGF2602...)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lastSequence": { "type": "number" },
        "prefix": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "lastSequence"]
    },
    "Review": {
      "title": "Review",
      "description": "Individual reviewer rubric evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicationId": { "type": "string" },
        "reviewerId": { "type": "string" },
        "reviewerEmail": { "type": "string" },
        "reviewerName": { "type": "string" },
        "isVoting": { "type": "boolean" },
        "scores": { "type": "object" },
        "comments": { "type": "object" },
        "totalScore": { "type": "number" },
        "generalFeedback": { "type": "string" },
        "recused": { "type": "boolean" },
        "recusalReason": { "type": "string" },
        "flaggedForDiscussion": { "type": "boolean" },
        "isSubmitted": { "type": "boolean" },
        "submittedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "applicationId", "reviewerEmail"]
    },
    "ReviewerProfile": {
      "title": "ReviewerProfile",
      "description": "Reviewer committee roster and appreciation records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isVoting": { "type": "boolean" },
        "cyclesServed": { "type": "number" },
        "mailingAddress": { "type": "string" },
        "shirtSize": { "type": "string" },
        "notes": { "type": "string" },
        "inviteSent": { "type": "boolean" },
        "inviteSentAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "SentEmail": {
      "title": "SentEmail",
      "description": "Server-side audit log of dispatched foundation emails",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipient": { "type": "string" },
        "allRecipients": { "type": "array" },
        "subject": { "type": "string" },
        "type": { "type": "string" },
        "delivered": { "type": "boolean" },
        "simulated": { "type": "boolean" },
        "timestamp": { "type": "string" },
        "grantCode": { "type": "string" },
        "applicationId": { "type": "string" },
        "sentByUid": { "type": "string" },
        "sentByEmail": { "type": "string" },
        "messageId": { "type": "string" },
        "error": { "type": "string" }
      },
      "required": ["id", "recipient", "subject", "type", "timestamp"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Expiring reviewer and evaluator invitations with unguessable tokens",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "token": { "type": "string" },
        "status": { "type": "string" },
        "cyclesServed": { "type": "number" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "acceptedAt": { "type": "string" },
        "revokedAt": { "type": "string" }
      },
      "required": ["id", "email", "token", "status", "expiresAt"]
    },
    "LegalDocument": {
      "title": "LegalDocument",
      "description": "Admin-editable Terms of Service and Privacy Policy documentation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "System-wide administrative change and audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "category": { "type": "string" },
        "details": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "timestamp": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "action", "details", "userEmail", "timestamp"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "ProgramSettings",
      "description": "Program configuration and cycle dates"
    },
    "/rubrics/{rubricId}": {
      "schema": "Rubric",
      "description": "Scoring rubric settings"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Blind grant proposals without applicant personal info"
    },
    "/applications/{applicationId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Scoring reviews by committee members"
    },
    "/applicantIdentities/{applicationId}": {
      "schema": "ApplicantIdentity",
      "description": "Admin-only sensitive applicant personal identities"
    },
    "/counters/{counterId}": {
      "schema": "GrantCounter",
      "description": "Atomic transaction counter for grant code generation"
    },
    "/reviewers/{reviewerId}": {
      "schema": "ReviewerProfile",
      "description": "Reviewer committee roster and appreciation info"
    },
    "/sent_emails/{emailId}": {
      "schema": "SentEmail",
      "description": "Server-side sent email audit logs"
    },
    "/invites/{inviteId}": {
      "schema": "Invite",
      "description": "Reviewer and administrator expiring invitations"
    },
    "/legal/{docId}": {
      "schema": "LegalDocument",
      "description": "Editable Terms of Service and Privacy Policy"
    },
    "/auditLogs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Administrative audit trail logs"
    }
  }
}
